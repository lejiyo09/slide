{
  "name": "slidelab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SlideLab — 웹 기반 프레젠테이션 편집기",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs && node e2e/stage8.mjs && node e2e/stage9.mjs && node e2e/stage10.mjs && node e2e/stage11.mjs && node e2e/stage12.mjs && node e2e/stage13.mjs && node e2e/stage14.mjs && node e2e/offline.mjs",
    "verify:pptx": "python3 scripts/verify_pptx.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@fontsource/stix-two-math": "5.3.0",
    "dictionary-en": "4.0.0",
    "dictionary-ko": "2.0.0",
    "hunspell-asm": "4.0.2",
    "idb": "^8.0.4",
    "immer": "^11.2.9",
    "jszip": "^3.10.2",
    "lucide-react": "^1.68.0",
    "mediabunny": "1.62.1",
    "modern-screenshot": "4.7.0",
    "nanoid": "^5.1.16",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "temml": "0.14.0",
    "three": "0.186.1",
    "woff2-encoder": "2.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "4.14.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
